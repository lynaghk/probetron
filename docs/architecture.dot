digraph probetron {
  graph [
    bgcolor="#FFFFFF"
    fontname="Arial"
    fontsize=18
    label="Probetron system architecture"
    labelloc=t
    nodesep=0.35
    ranksep=0.7
    pad=0.2
    splines=ortho
  ]

  node [
    color="#52606D"
    fillcolor="#FFFFFF"
    fontcolor="#102A43"
    fontname="Arial"
    fontsize=11
    margin="0.12,0.08"
    shape=box
    style="rounded,filled"
  ]

  edge [
    color="#627D98"
    fontcolor="#334E68"
    fontname="Arial"
    fontsize=9
    penwidth=1.2
  ]

  build [label="Build host\nDebian arm64", fillcolor="#F0F4F8"]
  image [label="Pinned rig image\nSD card", fillcolor="#F0F4F8"]
  build -> image [label="bb package / bb image"]

  client [label="Lab client\nmacOS or Linux\nprobetron CLI", fillcolor="#E8F1FB", color="#3973AC"]
  lan [label="Lab LAN\nSSH + key HTTP", fillcolor="#E8F1FB", color="#3973AC"]
  usb [label="USB-C console\nUSB Ethernet\n192.168.99.1", fillcolor="#E8F1FB", color="#3973AC"]

  subgraph cluster_rig {
    label="Raspberry Pi 4B rig"
    color="#39845A"
    fillcolor="#EAF6EE"
    fontcolor="#153B24"
    fontname="Arial"
    style="rounded,filled"

    access [label="Access layer\nprobetron-key.service\nsshd"]
    runner [label="probetron-rig\nrunner + target lock\nactive operation + DUT log"]
    byte [label="Byte service\nsocat\n127.0.0.1:5555"]
    dap [label="DAP service\nprobe-rs\n127.0.0.1:50000"]
    rtt [label="RTT decoder\nprobe-rs"]

    access -> runner
    runner -> byte [label="connect"]
    runner -> dap [label="debug"]
    runner -> rtt [label="optional --rtt"]
  }

  image -> runner [label="boot"]
  client -> lan
  client -> usb
  lan -> access
  usb -> access
  client -> runner [label="SSH remote command\nELF over stdin"]
  client -> byte [label="SSH local forward"]
  client -> dap [label="SSH local forward"]

  subgraph cluster_hw {
    label="Fixed target slot"
    color="#B7791F"
    fillcolor="#FFF3DC"
    fontcolor="#4A2C0A"
    fontname="Arial"
    style="rounded,filled"

    swd [label="SPI0 SWD\n/dev/spidev0.0"]
    reset [label="RUN reset\nGPIO26 / gpioset"]
    uart [label="UART0\n/dev/ttyAMA0"]
    dutusb [label="USB CDC\n/dev/probetron-dut"]
    dut [label="ARM SWD DUT", fillcolor="#FFF3DC", color="#B7791F"]

    swd -> dut
    reset -> dut
    uart -> dut
    dutusb -> dut
  }

  runner -> swd [label="info / flash / erase / reset"]
  runner -> reset
  byte -> dutusb [label="channel usb or uart"]
  byte -> uart [label="channel uart"]
  rtt -> swd [label="SWD reads"]
}

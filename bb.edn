{:paths ["src" "test"]
 :tasks
 {test    {:doc "Run the Probetron test suite"
           :requires ([probetron.test-runner :as test-runner])
           :task (test-runner/run-tests!)}
  lint    {:doc "Lint the Probetron sources with clj-kondo"
           :task (shell "clj-kondo --lint src test")}
  check   {:doc "Run lint and tests"
           :depends [lint test]}
  package {:doc "Build the release archive under build/"
           :requires ([probetron.provisioning.package :as package])
           :task (System/exit (package/main! *command-line-args*))}
  image   {:doc "Build the pinned Raspberry Pi 4 rig image under build/"
           :requires ([probetron.provisioning.image :as image])
           :task (System/exit (image/main! *command-line-args*))}
  disks   {:doc "List the disks this macOS host can see, removable ones lettered"
           :requires ([probetron.provisioning.flash :as flash])
           :task (System/exit (flash/list-disks! *command-line-args*))}
  flash   {:doc "Write a built image to a removable disk, picked or named (macOS)"
           :requires ([probetron.provisioning.flash :as flash])
           :task (System/exit (flash/flash! *command-line-args*))}
  rig-dev-deploy {:doc "Deploy the working-tree rig code to a rig over SSH, no reflash (development)"
                  :requires ([probetron.dev :as dev])
                  :task (System/exit (dev/deploy! *command-line-args*))}
  rig-dev-reset  {:doc "Remove the dev code overlay on a rig, restoring the image code (development)"
                  :requires ([probetron.dev :as dev])
                  :task (System/exit (dev/reset-overlay! *command-line-args*))}}}

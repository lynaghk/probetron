[Unit]
Description=Probetron volatile operation state
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target systemd-tmpfiles-setup.service
After=swap.target

[Mount]
What=tmpfs
Where=/run/probetron
Type=tmpfs
Options=mode=0755,nosuid,nodev,noexec,size=256M,nr_inodes=4k

[Install]
WantedBy=local-fs.target

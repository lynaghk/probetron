[Unit]
Description=Probetron volatile /tmp
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target systemd-tmpfiles-setup.service
After=swap.target

[Mount]
What=tmpfs
Where=/tmp
Type=tmpfs
Options=mode=1777,strictatime,nosuid,nodev,size=128M,nr_inodes=32k

[Install]
WantedBy=local-fs.target

[Unit]
Description=Probetron rig key service
Documentation=file:/usr/local/README.md
After=network.target

[Service]
Type=exec
User=probetron-key
Group=probetron-key
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
ExecStart=/usr/bin/socat -T 5 TCP-LISTEN:80,reuseaddr,fork,max-children=8 EXEC:/usr/local/libexec/probetron-key-http
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target

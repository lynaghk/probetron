#!/bin/sh
# Answer one HTTP request for the rig key on standard input and standard
# output, and answer nothing else.
# socat gives this program one accepted connection at a time, so it needs no
# state, no configuration, and no listening socket of its own.
set -eu

key=/etc/probetron/probetron_key
resource=/probetron_key

respond() {
   printf 'HTTP/1.0 %s\r\nContent-Type: %s\r\nContent-Length: %s\r\nConnection: close\r\n\r\n' "$1" "$2" "$3"
}

fail() {
   body="$2
"
   respond "$1" text/plain "${#body}"
   printf '%s' "$body"
   exit 0
}

read -r method target rest || exit 0
target=$(printf '%s' "$target" | tr -d '\r')

# Drain the request headers, so the client sees the answer and not a reset.
while read -r line; do
   line=$(printf '%s' "$line" | tr -d '\r')
   test -n "$line" || break
done

test "$method" = GET || fail '405 Method Not Allowed' 'only GET reaches the Probetron rig key'
test "$target" = "$resource" || fail '404 Not Found' "the Probetron rig serves $resource alone"
test -r "$key" || fail '500 Internal Server Error' "missing $key: rebuild the rig image"

respond '200 OK' application/octet-stream "$(wc -c < "$key")"
cat "$key"

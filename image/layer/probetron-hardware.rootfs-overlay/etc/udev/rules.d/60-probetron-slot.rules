# Each SWD connection has an exact discovery alias.
# The empty probetron-hardware group keeps direct hardware access restricted
# to root, reached through the locked rig entry point.
SUBSYSTEM=="spidev", KERNEL=="spidev0.0", GROUP="probetron-hardware", MODE="0660", SYMLINK+="spidev_swd0"
SUBSYSTEM=="spidev", KERNEL=="spidev1.0", GROUP="probetron-hardware", MODE="0660", SYMLINK+="spidev_swd1"

# GPIO26 resets SPI0's DUT; GPIO16 resets SPI1's DUT.
SUBSYSTEM=="gpio", KERNEL=="gpiochip0", GROUP="probetron-hardware", MODE="0660"

# UART0 on GPIO14 and GPIO15 belongs to SPI0 alone.
SUBSYSTEM=="tty", KERNEL=="ttyAMA0", GROUP="probetron-hardware", MODE="0660"

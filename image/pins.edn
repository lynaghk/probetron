;; Every pinned input of the Probetron rig image.
;; probetron.provisioning.image reads this file, and nothing else in the
;; project states an image version, an archive URL, or a checksum.
;; A pin moves only when hardware qualification records the move here.
{:host
 {:id "debian"
  :version-id "13"
  :codename "trixie"
  :machine "aarch64"
  :description "Debian 13 arm64, the only host that may build the image"}

 :rpi-image-gen
 {:url "https://github.com/raspberrypi/rpi-image-gen.git"
  :tag "v2.8.0"
  :revision "262d4df5a9f9d4133370465399a7958a7c22cdc7"
  :checkout ".cache/rpi-image-gen"}

 :suite
 {:name "trixie"
  :architecture "arm64"
  :layer "debian-trixie-arm64-minbase-snapshot"
  :snapshot "20260801T000000Z"
  :snapshot-epoch 1785542400
  :glibc "2.41"}

 :device
 {:class "pi4"
  :layer "rpi4"
  :image-layer "image-rpios"
  :image-name "probetron-rpi4"}

 :babashka
 {:version "1.13.219"
  :url "https://github.com/babashka/babashka/releases/download/v1.13.219/babashka-1.13.219-linux-aarch64-static.tar.gz"
  :sha256 "e8d7a9c66c364b80627a43cb6ba5c14fb6ac7e4af114e8e5d80f97551ccdfe11"
  :member "bb"
  :install "/usr/local/bin/bb"}

 ;; probe-rs 0.32 is the initial pin.
 ;; A later pin belongs here only once hardware qualification records that
 ;; probe-rs identifies an RP2350 over the direct Linux SPI SWD wiring.
 :probe-rs
 {:version "0.32.0"
  :url "https://github.com/probe-rs/probe-rs/releases/download/v0.32.0/probe-rs-tools-aarch64-unknown-linux-gnu.tar.xz"
  :sha256 "7c818cfd77808e806bf8f4d108c9137910b4fb28e0fe5c464d39782dbbc8af31"
  :member "probe-rs-tools-aarch64-unknown-linux-gnu/probe-rs"
  :install "/usr/local/bin/probe-rs"
  :glibc "2.39"}

 ;; The one DUT slot. Both values stay nil on an ordinary rig, which owns one
 ;; DUT and carries no console, so the udev rule matches the one CDC serial
 ;; device it can see. A board in BOOTSEL is mass storage and a USB-serial
 ;; adapter binds another driver, so neither is ever mistaken for the DUT.
 ;; Record them on a bench that really does present a second CDC device: the
 ;; rule then narrows to one physical socket, and a board anywhere else is not
 ;; the DUT. Read them from a booted rig with
 ;; `udevadm info --attribute-walk --name=/dev/ttyACM0`.
 ;; `:usb-port-label` is the board-relative receptacle, for example
 ;; "lower USB 2.0 receptacle nearest the Ethernet jack".
 ;; `:usb-kernels` is the exact KERNELS ancestry of the CDC interface, for
 ;; example "1-1.3".
 ;; Nothing here defaults the receptacle, because a guessed one would make some
 ;; other socket the DUT without saying so.
 :dut
 {:device-name "probetron-dut"
  :usb-port-label nil
  :usb-kernels nil}}
